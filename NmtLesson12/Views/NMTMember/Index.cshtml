@model IEnumerable<TvcLesson12.Models.NMTMember>

@{
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Danh sách thành viên</h2>
    </div>
    <a asp-action="NMTCreate" class="btn btn-primary">Thêm học viên</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Họ và tên</th>
            <th>Tên đăng nhập</th>
            <th>Email</th>
            <th class="text-center" style="width: 220px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Chưa có dữ liệu.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NMTFullName</td>
                    <td>@item.NMTUserName</td>
                    <td>@item.NMTEmail</td>
                    <td class="text-center">
                        <a asp-action="NMTDetails" asp-route-id="@item.NMTMemberId" class="btn btn-sm btn-info text-white">Chi tiết</a>
                        <a asp-action="NMTEdit" asp-route-id="@item.NMTMemberId" class="btn btn-sm btn-warning text-white">Sửa</a>
                        <a asp-action="NMTDelete" asp-route-id="@item.NMTMemberId" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
