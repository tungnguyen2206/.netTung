<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NMT</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">NMT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="NMTMember" asp-action="Index">Members</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                        </li>
                    </ul>
                    <span class="navbar-text text-white-50">Lesson 14 - ASP.NET Core Layout</span>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <div class="row g-4">
            <aside class="col-lg-3">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body">
                        <h5 class="card-title text-primary">Menu</h5>
                        <div class="list-group list-group-flush">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action">Trang chủ</a>
                            <a asp-area="" asp-controller="NMTMember" asp-action="Index" class="list-group-item list-group-item-action">Quản lý thành viên</a>
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action">Admin Dashboard</a>
                        </div>
                    </div>
                </div>
            </aside>

            <main class="col-lg-9">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        @RenderBody()
                    </div>
                </div>
            </main>
        </div>
    </div>

    <footer class="border-top bg-white mt-4">
        <div class="container py-3 text-center text-muted">
            &copy; 2026 - NMT - ASP.NET Core MVC Layout Demo
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
