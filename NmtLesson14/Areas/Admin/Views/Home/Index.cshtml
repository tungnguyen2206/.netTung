@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="text-primary mb-3">Admin Dashboard</h2>
<p class="text-muted">Khu vực quản trị được tách riêng bằng Area.</p>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 bg-primary text-white h-100">
            <div class="card-body">
                <h5 class="card-title">Thành viên</h5>
                <p class="card-text">Quản lý thông tin người dùng.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-success text-white h-100">
            <div class="card-body">
                <h5 class="card-title">Báo cáo</h5>
                <p class="card-text">Theo dõi và thống kê dữ liệu hệ thống.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-warning text-dark h-100">
            <div class="card-body">
                <h5 class="card-title">Cài đặt</h5>
                <p class="card-text">Tùy chỉnh hệ thống theo nhu cầu.</p>
            </div>
        </div>
    </div>
</div>
